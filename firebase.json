{
  "hosting": {
    "public": "public-web",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "headers": [
      {
        "source": "/download/**",
        "headers": [
          {
            "key": "Content-Type",
            "value": "application/zip"
          },
          {
            "key": "Content-Disposition",
            "value": "attachment; filename=\"NexusArena-Organizer-Windows.zip\""
          },
          {
            "key": "Cache-Control",
            "value": "no-cache, no-store, must-revalidate"
          }
        ]
      }
    ],
    "rewrites": [
      {
        "source": "!/download/**",
        "destination": "/index.html"
      }
    ]
  },
  "firestore": {
    "rules": "firestore.rules"
  }
}
